# General Settings
PROJECT_NAME="EduQuest AI"
API_V1_STR="/api/v1"
ENVIRONMENT="dev" # Options: local, dev, prod

# CORS
# Comma-separated list of allowed origins. Use ["*"] for dev to allow all.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="SECRET_KEY_CHANGEME"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
ALGORITHM="HS256"

# Database (MongoDB)
# Format: mongodb://username:password@host:port/database_name
# Matches docker-compose.yml defaults (Auth disabled for local dev)
MONGODB_URL="mongodb://localhost:27017"
# Application Port
PORT=8001
DATABASE_NAME="eduquest"

# Redis
# Format: redis://:password@host:port
# Matches docker-compose.yml defaults
REDIS_URL="redis://:securepassword@localhost:6379"
